APP_NAME=Shoutrrr
APP_KEY=
APP_URL=https://your-app.example
SESSION_SECURE_COOKIE=true

# The bundled production Compose file must deploy this fork's image, not the
# upstream Shoutrrr image. Publish a release before using the :latest tag, or
# replace it with a sha-* tag created by a manual release workflow run.
SHOUTRRR_IMAGE=ghcr.io/danielapassos/dani-fully:latest

# Running behind a TLS-terminating reverse proxy or tunnel (Cloudflare Tunnel,
# Traefik, nginx, a load balancer)? Set this so Octane forces https on generated
# URLs (redirects, route()). Without it, post-login redirects can come out
# http:// and the browser blocks them. Requires APP_URL to be your https address.
OCTANE_HTTPS=true

# Trust your reverse proxy's forwarding headers (X-Forwarded-Proto/-Host/-Port).
# This is the precise complement to OCTANE_HTTPS: it lets the app detect the real
# scheme/host/client-IP per request (so redirects, OAuth callback URLs, and
# per-IP rate limits are correct) instead of forcing https unconditionally. Set
# `*` when the container is only reachable through the proxy, or a comma-separated
# IP/CIDR list to trust specific proxies. Leave unset to trust no proxies.
TRUSTED_PROXIES=*

# Compose publishes the app port on loopback by default so a proxy cannot be
# bypassed with spoofed forwarding headers. Set 0.0.0.0 only when you knowingly
# want direct host-network access to APP_PORT.
# APP_BIND_HOST=127.0.0.1

# Disable social login unless OAuth credentials are configured.
SOCIALITE_ENABLED=false

# ----------------------------------------------------------------------
# Optional production / deployment overrides
# ----------------------------------------------------------------------
# This single-server Compose template persists `storage`, so Shoutrrr can safely
# generate one Passport keypair there the first time an API/MCP key is issued.
# Cloud, ephemeral-storage, and multi-replica deployments must instead provide one
# shared PEM pair through secrets and set PASSPORT_AUTO_GENERATE_KEYS=false.
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=
PASSPORT_AUTO_GENERATE_KEYS=true

# Disk used for all media (images + video). Use `public` for local/public
# storage, or `s3` with the AWS_* values below for object storage.
# FILESYSTEM_DISK=public

# To store media on S3 (or S3-compatible: MinIO, R2, Spaces), set
# FILESYSTEM_DISK=s3 and fill these in. Direct video uploads require bucket CORS
# to allow PUT and GET from APP_URL and expose ETag (the editor fetches the
# source blob directly); also expire tmp/media/ after ~1 day.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_ENDPOINT=
# AWS_URL=
# AWS_USE_PATH_STYLE_ENDPOINT=true

# Exact public HTTPS base from which providers fetch stored media. TikTok requires
# this domain or URL prefix to be verified in its developer app. Laravel Cloud does
# not inject the public bucket URL automatically; copy the displayed AWS_URL here.
# PUBLIC_MEDIA_URL=https://media.example.com

# Social login (Laravel Socialite). Supported: google, x, linkedin.
# SOCIALITE_ENABLED=true
# SOCIALITE_PROVIDERS=google,x,linkedin
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Connected accounts (workspace-owned posting accounts). Register callbacks:
# X:                  ${APP_URL}/accounts/callback/x
# LinkedIn:           ${APP_URL}/accounts/callback/linkedin
# Facebook+linked IG: ${APP_URL}/accounts/callback/meta      (IG discovered via linked Pages)
# Instagram:          ${APP_URL}/accounts/callback/instagram (direct Instagram Login app)
# Threads:            ${APP_URL}/accounts/callback/threads   (a separate Meta app)
# TikTok:             ${APP_URL}/accounts/callback/tiktok
# YouTube:            ${APP_URL}/accounts/callback/youtube
# X — scopes: users.read, users.email, tweet.read, tweet.write, media.write, offline.access
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_REDIRECT_URI="${APP_URL}/accounts/callback/x"
# LinkedIn — scopes: openid, profile, email, w_member_social
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REDIRECT_URI="${APP_URL}/accounts/callback/linkedin"
# Facebook + Instagram — one Meta app. Scopes: pages_show_list, pages_read_engagement,
# pages_manage_posts, pages_read_user_content, pages_manage_engagement, read_insights,
# business_management, instagram_basic, instagram_content_publish,
# instagram_manage_comments, instagram_manage_insights. Publishing needs Meta App
# Review + Business Verification for non-test accounts.
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# FACEBOOK_REDIRECT_URI="${APP_URL}/accounts/callback/meta"
# FACEBOOK_GRAPH_VERSION=v25.0

# Direct Instagram Login — professional Business/Creator accounts without a
# linked Facebook Page. Keep messaging off until Meta approves that scope.
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_REDIRECT_URI="${APP_URL}/accounts/callback/instagram"
# INSTAGRAM_GRAPH_API_VERSION=v25.0
# INSTAGRAM_DIRECT_MESSAGES_ENABLED=false

# Threads — separate Meta app. Scopes: threads_basic, threads_content_publish, threads_delete,
# threads_manage_replies, threads_manage_insights.
# THREADS_CLIENT_ID=
# THREADS_CLIENT_SECRET=
# THREADS_REDIRECT_URI="${APP_URL}/accounts/callback/threads"

# TikTok creator-inbox handoff. Keep disabled until app review and the exact
# PUBLIC_MEDIA_URL domain/prefix verification are complete.
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI="${APP_URL}/accounts/callback/tiktok"
# TIKTOK_INBOX_ENABLED=false

# YouTube uses the Google OAuth client above with a distinct callback. Keep
# publishing fail-closed until every upload declaration has been reviewed.
# YOUTUBE_REDIRECT_URI="${APP_URL}/accounts/callback/youtube"
# YOUTUBE_PUBLISHING_ENABLED=false
# YOUTUBE_PRIVACY_STATUS=private
# YOUTUBE_CATEGORY_ID=22
# YOUTUBE_FORMAT_INTENT=short
# YOUTUBE_MADE_FOR_KIDS=false
# YOUTUBE_CONTAINS_SYNTHETIC_MEDIA=false
# YOUTUBE_HAS_PAID_PRODUCT_PLACEMENT=false
# YOUTUBE_NOTIFY_SUBSCRIBERS=false

# Docker / Octane knobs when overriding compose/image defaults.
# QUEUE_WORKER_ENABLED=false
# SCHEDULER_ENABLED=false
# INERTIA_SSR_ENABLED=true
